# foldyard per-developer overrides — claude-code-log   (TEMPLATE — copy, don't edit in place)
#
#     cp foldyard.local.toml.example foldyard.local.toml
#
# The copy is GITIGNORED and yours alone. It is deep-merged OVER the committed
# foldyard.toml — tables merge key-by-key, so a `keyless` here lands beside the shared
# `system_prompt` rather than replacing the table. Full resolution order:
#     explicit env var  →  foldyard.local.toml  →  foldyard.toml  →  built-in default
# (arrays, including arrays-of-tables like [[inject]], are replaced WHOLESALE — redeclare
# every entry you still want, not just the new one).
#
# What belongs here: anything true of YOU rather than of the project — which agent you pay
# for, how big your machine is, which port a worktree must land on, your own GitHub App.
# Nothing secret: keyless auth and injected tokens are stored on your computer
# (~/.foldyard/<project>/host.env), never in the repo and never in the box.
#
# This file drives host-side credential injection, so your computer runs the copy you
# ADOPTED: after editing, `fy config adopt` (or answer the prompt at the next `fy up` /
# `fy box up`).

# ── Turn a shared block OFF: `disabled = true` ───────────────────────────────────────────
# The merge can otherwise only ADD, and several tables are PRESENCE-gated — declaring
# [claude] / [codex] / [vscode] / [plugins.<name>] at all IS the opt-in — so blanking their
# keys doesn't switch them off. `disabled = true` removes the block from the resolved config
# as if it had never been written; the team keeps it, you don't get it. The case it exists
# for: this repo commits [codex], you don't have a ChatGPT or OpenAI subscription, and you'd
# rather not have the CLI installed on box-up, be asked for a credential, or carry a dead
# codex row in `fy mode`. Works at any depth ([plugins.<name>] too), and `disabled = false`
# here puts a block back that the SHARED file disabled. `fy config widenings` lists what
# you've removed.
# [codex]
# disabled = true

# ── Keyless agent auth — the real credential never enters the box ────────────────────────
# The box gets a DUMMY; the egress proxy swaps in the real token host-side, in flight. The
# shared foldyard.toml already turns it on for both agents:
#   [claude] keyless = "oauth"    — a long-lived OAuth token (sk-ant-oat…) from
#                                   `claude setup-token`, run on your computer.
#   [codex]  keyless = "chatgpt"  — your ChatGPT subscription: the access token is minted and
#                                   refreshed from ~/.codex/auth.json on your computer (run
#                                   `codex login` there once). No key.
# `fy mode claude=on` / `fy mode codex=on` prompts once (hidden) for anything missing and
# stores it host-side. Override here only if yours differs:
#   "api-key" — an API key instead (Anthropic: sk-ant-api… from console.anthropic.com;
#               OpenAI: sk-…), captured the same way.
#   false     — no keyless: a plain in-box `claude` / `codex login`, real credentials in the
#               box (kept across recreation).
# [claude]
# keyless = "api-key"
#
# [codex]
# keyless = false

# ── Your machine, not the project's ──────────────────────────────────────────────────────
# The committed sizing (8 CPUs, 16 GiB) suits the project; this suits your laptop. Sizing
# and vmtype apply when the VM is CREATED, so changing them later needs
# `fy machine recreate`.
# [machine]
# cpus = 4
# memory_mib = 8192   # MiB — any whole number
# disk_gib = 60
# vmtype = "vz"   # the hypervisor, at creation: vz is macOS only, qemu everywhere
#
# Desktop notifications when a credential stops or starts working (macOS today).
# [host]
# notifications = false
#
# Your agent's own session settings, merged over the shared ones key by key.
# [claude.settings]
# model = "opus"

# ── Pin a worktree's host-port offset ────────────────────────────────────────────────────
# A worktree's ports are offset by 1..89, recorded per worktree on your computer so two
# checkouts never collide. Pin a SMALL fixed offset when a worktree needs a KNOWN port —
# the usual reason is a third-party service that only redirects to pre-registered callback
# URLs (an identity provider allowing localhost:3000..3005, say). Every port shifts by the
# same N, and a pinned offset is never given to another worktree. Read from the MAIN
# checkout's file wherever `fy` runs; WT_OFFSET in the environment still wins.
# [worktree-offsets]
# my-worktree = 1

# ── Credentials injected into the box's requests: [[inject]] ────────────────────────────
# Each row is its own on/off switch (`fy mode <switch>=on`). The real credential lives in
# ~/.foldyard/<project>/host.env as FY_INJECT_<SWITCH>, and `fy mode <switch>=on` prompts for
# it if it's missing; the box holds only the dummy in `box_env`, which its client sends for
# the proxy to replace. While the switch is on its host is allowed through the proxy — no
# grant needed. Adding a row (or changing its box_env) needs `fy box recreate`: the box's
# environment is fixed when it's created.
# An [[inject]] here REPLACES the shared file's rows WHOLESALE: copy in every row of
# foldyard.toml you still want, or they're gone for you, and keep all of yours in this file.
#
# GitHub for the box (`gh` is installed; it reads GH_TOKEN): a GitHub App of YOUR OWN,
# installed on your fork or this repo, minted into an hour-long installation token on your
# computer. The App's installation permissions are the token's scope. Registering it, and
# where the two ids are shown: `fy docs github-app`.
# [[inject]]
# switch = "github"
# kind = "github-app"
# app_id = "123456"              # the App ID (a number), not the Client ID
# installation_id = "7654321"
# repositories = ["claude-code-log"]   # optional: narrow the token to these repositories
# box_env = { GH_TOKEN = "x" }
#
# A static token of your own (e.g. your own MCP endpoint):
# [[inject]]
# switch = "myservice"
# host   = "my-host.example.com"
# header = "Authorization"
# label  = "My private service"
# box_env = { MYSERVICE_TOKEN = "x" }
# emergency = true   # optional: `on` expires (default 1h) and switches itself off
