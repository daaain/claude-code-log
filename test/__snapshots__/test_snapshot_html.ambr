  :root[data-theme="dark"] .theme-minimal .highlight .nf { color: #d2a8ff; font-weight: bold }
  :root[data-theme="dark"] .theme-minimal .highlight .nl { color: #79c0ff; font-weight: bold }
  :root[data-theme="dark"] .theme-minimal .highlight .nn { font-weight: normal; color: #ff7b72 }
  :root[data-theme="dark"] .theme-minimal .highlight .nx { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .py { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .nt { font-weight: normal; color: #7ee787 }
  :root[data-theme="dark"] .theme-minimal .highlight .nv { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .ow { color: #ff7b72; font-weight: bold }
  :root[data-theme="dark"] .theme-minimal .highlight .pm { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .w { color: #6e7681 }
  :root[data-theme="dark"] .theme-minimal .highlight .mb { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .mf { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .mh { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .mi { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .mo { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sa { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sb { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sc { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .dl { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sd { font-style: normal; color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .s2 { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .se { font-weight: normal; color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sh { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .si { font-weight: normal; color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sx { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .sr { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .s1 { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .ss { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .bp { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .fm { color: #d2a8ff; font-weight: bold }
  :root[data-theme="dark"] .theme-minimal .highlight .vc { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .vg { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .vi { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .vm { color: #79c0ff }
  :root[data-theme="dark"] .theme-minimal .highlight .il { color: #a5d6ff }
  /* Minimal theme (--theme minimal): the DAG layout driven by minimal_dag.js.
     work/minimal-theme-dag.md § 1.6 / § 3.5; dev-docs/minimal-theme.md.
  
     Without JavaScript none of this applies (no `dag-on`): sub-agent
     transcripts render nested under their spawning card (layout.css "nested
     sub-agents") and fork branches as branch headers, as before.
  
     With the engine on (`dag-on`), every `.message-node` / `.children`
     wrapper is `display: contents` and #transcript is a one-column grid in
     which each card has an inline `grid-row`. Rows are packed as if every
     branch were interleaved; a folded branch is hidden and its rows are
     empty (zero height). A fold (inline `display: none` on a `.children`)
     still hides its subtree: an inline style beats these rules. Hiding rules
     carry at least two classes (layout.css "Specificity, two tiers"). */
  
  /* Lane colours (rail slot → colour; forks are always --lF). */
  .theme-minimal .dag-lc-a { --lc: var(--lA); }
  .theme-minimal .dag-lc-b { --lc: var(--lB); }
  .theme-minimal .dag-lc-f { --lc: var(--lF); }
  .theme-minimal .dag-lc-s { --lc: var(--sys); }
  .theme-minimal .dag-lc-p { --lc: var(--asst); }
  
  .theme-minimal .dag-s1 { --dag-slot: 1; }
  .theme-minimal .dag-s2 { --dag-slot: 2; }
  .theme-minimal .dag-s3 { --dag-slot: 3; }
  .theme-minimal .dag-s4 { --dag-slot: 4; }
  .theme-minimal .dag-s5 { --dag-slot: 5; }
  .theme-minimal .dag-s6 { --dag-slot: 6; }
  
  /* ------------------------------------------------------------- stage */
  
  /* Rail geometry (the engine reads --dag-x0 / --dag-step to draw): the main
     line sits --dag-x0 into the rail column, each lane slot --dag-step to its
     right (mockup .sl: 16px slots). The rail column widens by one step per
     slot in use (--dag-slots, written by the engine). */
  .theme-minimal .mn-stage {
      --dag-x0: 9px;
      --dag-step: 16px;
      --dag-ind0: 8px;
      --dag-ind-step: 16px;
  }
  
  /* One layout at load (follow-up to P8): while the page parses, the stage is
     not rendered — theme_init.js puts `mn-parsing` on <html> and its
     DOMContentLoaded listener, the page's first, takes it off — so the
     browser's frames during a long parse lay out the header only, and the
     transcript's first layout is the engine's grid rather than the nested
     page it then replaces. Only with JavaScript: without it the class never
     exists and the transcript renders nested as it parses. */
  .mn-parsing .theme-minimal .mn-stage {
      display: none;
  }
  
  .theme-minimal .mn-stage.dag-on {
      --dag-gut: var(--gut);
      --dag-rail: calc(var(--rail) + var(--dag-step) * var(--dag-slots, 0));
  }
  
  .theme-minimal #dag-rail {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
  }
  
  .theme-minimal #dag-rail svg {
      position: absolute;
      top: 0;
      left: 0;
      overflow: visible;
  }
  
  .theme-minimal #dag-rail path {
      fill: none;
      stroke: var(--lc);
      stroke-width: 2;
  }
  
  /* Folded branch: a dashed lane (mockup .dash: 3px on, 4px off). */
  .theme-minimal #dag-rail path.dag-dash {
      stroke-dasharray: 3 4;
  }
  
  /* Running branch (P7b): an agent with no result yet carries on to the
     newest row and ends in an open marker instead of merging; a folded one
     keeps its dashes, which drift slowly towards the open end. */
  .theme-minimal #dag-rail path.dag-end {
      fill: var(--bg);
      stroke-width: 1.6;
  }
  
  .theme-minimal #dag-rail path.dag-running.dag-dash {
      animation: dag-run 1.2s linear infinite;
  }
  
  @keyframes dag-run {
      to { stroke-dashoffset: -7; }
  }
  
  /* A column lane's pointers (`col-in`, `col-out`): a short curve towards the
     parent column that fades out, stroked with the rail's per-colour gradient
     (`dag-fade-<c>`, its stops in the lane colour: opaque at the lane, gone at
     the tip), so it follows the scheme. */
  .theme-minimal #dag-rail stop {
      stop-color: var(--lc);
  }
  
  .theme-minimal #dag-rail stop + stop {
      stop-opacity: 0.7;
  }
  
  .theme-minimal #dag-rail stop:last-child {
      stop-opacity: 0;
  }
  
  .theme-minimal #dag-rail path.dag-fade.dag-lc-a { stroke: url(#dag-fade-a); }
  .theme-minimal #dag-rail path.dag-fade.dag-lc-b { stroke: url(#dag-fade-b); }
  .theme-minimal #dag-rail path.dag-fade.dag-lc-f { stroke: url(#dag-fade-f); }
  .theme-minimal #dag-rail path.dag-fade.dag-lc-s { stroke: url(#dag-fade-s); }
  .theme-minimal #dag-rail path.dag-fade.dag-lc-p { stroke: url(#dag-fade-p); }
  
  @media (prefers-reduced-motion: reduce) {
      .theme-minimal #dag-rail path.dag-running.dag-dash,
      .theme-minimal #transcript .mn-bctl.is-running .mn-brun::before {
          animation: none;
      }
  }
  
  /* --------------------------------------------------------- flattening */
  
  .theme-minimal .mn-stage.dag-on #transcript .message-node,
  .theme-minimal .mn-stage.dag-on #transcript .children {
      display: contents;
  }
  
  /* An interleaved sub-agent's transcript is shown whatever the fold state
     machine last did to its container (fold depth keeps sub-agents folded;
     the Branches mode owns them here, spec § 1.5). */
  .theme-minimal .mn-stage.dag-on #transcript .children.dag-entry {
      display: contents !important;
  }
  
  /* A folded branch: its sub-agent container, or a fork's whole node. */
  .theme-minimal .mn-stage.dag-on #transcript .message-node.dag-hidden,
  .theme-minimal .mn-stage.dag-on #transcript .children.dag-hidden {
      display: none !important;
  }
  
  /* Nested groups that are not branches (teammate threads, old-style
     sidechains) stay one nested block, with their framed look and narrower
     gutter. */
  .theme-minimal .mn-stage.dag-on #transcript .children.dag-block,
  .theme-minimal .mn-stage.dag-on #transcript .dag-block .message-node,
  .theme-minimal .mn-stage.dag-on #transcript .dag-block .children {
      display: block;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
  }
  
  /* Every row shares the main gutter and the widened rail; nested-group
     values (layout.css) apply only inside a block. */
  .theme-minimal .mn-stage.dag-on #transcript .message-node {
      --gut: var(--dag-gut);
      --rail: var(--dag-rail);
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .dag-block .message-node {
      --gut: var(--gut-nest);
      --rail: var(--rail-nest);
  }
  
  /* Workflow phase and agent cards, and the agents' transcripts (lanes), are
     rows of the grid too: the nested workflow gutter (components.css) only
     applies without the engine, or inside a block. */
  .theme-minimal .mn-stage.dag-on #transcript .children:has(> .message-node > .message.workflow_phase) > .message-node:not(.dag-block *),
  .theme-minimal .mn-stage.dag-on #transcript .message-node:has(> .message.workflow_phase) > .children > .message-node:not(.dag-block *),
  .theme-minimal .mn-stage.dag-on #transcript .message-node:has(> .message.workflow_agent) > .children > .message-node:not(.dag-block *) {
      --gut: var(--dag-gut);
      --rail: var(--dag-rail);
  }
  
  /* The spawning result's fold bar would fold the same transcript the branch
     control does; the control is the one handle. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-owner > .fold-bar {
      display: none;
  }
  
  /* ---------------------------------------------------------- rail dots */
  
  /* Dots sit on their lane's slot: the main line for main rows, the lane's
     slot for interleaved rows (`--dag-slot` from `dag-sN`). */
  .theme-minimal .mn-stage.dag-on #transcript .message:not(.session-header)::before {
      justify-self: start;
      margin-left: calc(var(--dag-x0) + var(--dag-step) * var(--dag-slot, 0));
      transform: translateX(-50%);
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .dag-block .message:not(.session-header)::before {
      justify-self: center;
      margin-left: 0;
      transform: none;
  }
  
  /* -------------------------------------------------- interleaved rows */
  
  /* DagThreads.dc.html `.c3.in-*`: indented by the lane's slot, with a tint of
     the lane colour fading out to the right; the gutter names the lane
     (mockup .tag). */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-in {
      --dag-indent: calc(var(--dag-ind0) + var(--dag-ind-step) * var(--dag-slot, 1));
      --dag-c3: calc(var(--gut) + var(--rail));
      grid-template-columns: var(--gut) calc(var(--rail) + var(--dag-indent)) minmax(0, 1fr);
      background: linear-gradient(90deg,
          transparent var(--dag-c3),
          color-mix(in srgb, var(--lc) 9%, transparent) var(--dag-c3),
          transparent 75%);
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-in > .header > .header-info::after {
      content: var(--dag-tag, none);
      order: 1;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--lc);
      font-weight: 600;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-in > .header > .header-info > .mn-tok {
      order: 2;
  }
  
  /* P7c: a call half's gutter (time, role) hangs into its result half's
     (layout.css), so a third line there — the lane tag — ran into the result
     row's own gutter (an error pill) or the next row's. The tag moves to the
     result half's gutter instead, one gutter line down: time and role from
     the call, then the tag (and an error pill) from the result, which grows
     its row if it must rather than overlap the next. Wide layout only. */
  @media (min-width: 641px) {
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-in.pair_first:not(.dag-split) > .header > .header-info::after {
          content: none;
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-in:is(.pair_middle, .pair_last):not(.dag-split) > .header > .header-info {
          display: flex;
          padding-top: 1.85em;
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-in:is(.pair_middle, .pair_last):not(.dag-split):not(.error) > .header > .header-info > *,
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-in.error:is(.pair_middle, .pair_last):not(.dag-split) > .header > .header-info > :not(.mn-role) {
          display: none;
      }
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message:is(.dag-in, .dag-colin) > .header > .header-info::after {
      flex: none;
  }
  
  /* Branch headers in the stream: their text starts at the content column
     (the rail runs through the space before it, unmasked). */
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header {
      z-index: auto;
      padding-left: calc(var(--gut) + var(--rail) + 4px);
      background: transparent;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header.dag-in {
      padding-left: calc(var(--dag-c3) + var(--dag-indent) + 4px);
      border-top-color: var(--lc);
  }
  
  /* The earliest branch at a rewind continues the main line (§ 1.6.4): its
     header shrinks to a slim "⑂ rewound" marker. */
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] {
      margin: 4px 0 0 !important;
      padding-top: 2px;
      padding-bottom: 0;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] > .header {
      font: 400 0.72rem/1.6 var(--mono);
      color: var(--muted);
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] > .header::before {
      content: "⑂ rewound · ";
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] > .header > .mn-ic,
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] > .header > .branch-from,
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header[data-lane-continues] > .fold-bar {
      display: none;
  }
  
  /* A tool pair split by interleaved rows: both halves show in full — the
     result half becomes a row of its own (time, role, dot), as a merge row. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-split:is(.pair_middle, .pair_last) {
      padding-top: 3px;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-split:is(.pair_middle, .pair_last) > .header > .header-info {
      display: flex;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-split:is(.pair_middle, .pair_last)::before {
      display: block;
  }
  
  @media (min-width: 641px) {
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-split.pair_first > .header > .header-info {
          height: auto;
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-split.pair_first::before {
          margin-bottom: 0;
      }
  }
  
  /* ---------------------------------------------------- branch controls */
  
  /* On the spawn row (mockup .bctl): chevron + summary (+ "· interleaved" /
     "· in column →", `data-mode`), the Column ⇥ / ⇤ Interleave button and, on a turn's
     third control, "+N more branches". Row 4 of the card grid (layout.css). */
  .theme-minimal #transcript .mn-bctls {
      grid-column: 3;
      grid-row: 4;
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding-left: 4px;
  }
  
  .theme-minimal #transcript .fork-point > .mn-bctls {
      padding-left: 0;
      margin-top: 2px;
  }
  
  .theme-minimal #transcript .mn-bctl {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 10px;
      margin-top: 2px;
  }
  
  /* Wider than a phone, a control stays on one line (P8): in Columns the
     main column is only ~470px of content, and the stats, `Result ↓`,
     `launched ▸` and `⇤ Interleave` used to wrap the button onto a line of
     its own. The stats give way instead (ellipsis; the full text is in the
     chevron button's title and aria-label, and in the column head). A phone
     keeps wrapping: there is no room to truncate into. */
  @media (min-width: 641px) {
      .theme-minimal #transcript .mn-bctl {
          flex-wrap: nowrap;
      }
  
      .theme-minimal #transcript .mn-bctl > * {
          flex: none;
      }
  
      .theme-minimal #transcript .mn-bctl > .mn-bfold {
          flex: 0 1 auto;
          min-width: 0;
      }
  
      .theme-minimal #transcript .mn-bfold::after {
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
      }
  }
  
  /* A lane behind its turn's "+N more branches". */
  .theme-minimal #transcript .mn-bctl[hidden] {
      display: none;
  }
  
  .theme-minimal #transcript .mn-bfold {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 0;
      border: 0;
      background: none;
      font: 0.72em var(--mono);
      color: var(--lc);
      text-align: left;
      cursor: pointer;
  }
  
  .theme-minimal #transcript .mn-bfold::after {
      content: attr(data-label);
  }
  
  /* "· interleaved" / "· in column →": after the label (flex `order`), never
     truncated with it. */
  .theme-minimal #transcript .mn-bfold[data-mode]::before {
      content: attr(data-mode);
      order: 2;
      flex: none;
      margin-left: -6px;
      white-space: pre;
  }
  
  .theme-minimal #transcript .mn-bfold:hover {
      text-decoration: underline;
  }
  
  .theme-minimal #transcript .mn-bfold svg {
      flex: none;
      transition: transform 0.15s;
  }
  
  .theme-minimal #transcript .mn-bctl.is-open .mn-bfold svg {
      transform: rotate(90deg);
  }
  
  /* "running" beside a running branch's stats (P7b): generated content, so
     search and the timeline never index it. */
  .theme-minimal #transcript .mn-brun {
      display: none;
  }
  
  .theme-minimal #transcript .mn-bctl.is-running .mn-brun {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 0 6px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--lc) 12%, transparent);
      font: 0.66em var(--mono);
      color: var(--lc);
  }
  
  .theme-minimal #transcript .mn-brun::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      animation: dag-pulse 1.6s ease-in-out infinite;
  }
  
  .theme-minimal #transcript .mn-brun::after {
      content: attr(data-label);
  }
  
  @keyframes dag-pulse {
      50% { opacity: 0.25; }
  }
  
  .theme-minimal #transcript .mn-bmini {
      min-height: 22px;
      padding: 0 7px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--bg);
      font: 0.68em var(--mono);
      color: var(--muted);
      cursor: pointer;
  }
  
  .theme-minimal #transcript .mn-bmini:hover:not(:disabled) {
      border-color: var(--muted);
      color: var(--fg);
  }
  
  .theme-minimal #transcript .mn-bmini:disabled {
      opacity: 0.5;
      cursor: default;
  }
  
  .theme-minimal #transcript .mn-bmini[data-label]::after {
      content: attr(data-label);
  }
  
  .theme-minimal #transcript .mn-bmore {
      border-style: dashed;
  }
  
  /* Same-page links (teammate anchors, html/minimal_theme.cross_links): a
     muted line under the content, in row 4 of the card grid like the branch
     controls (a card never has both). Rendered server-side, so they work
     without JavaScript. */
  .theme-minimal #transcript .mn-xlinks {
      grid-column: 3;
      grid-row: 4;
      display: flex;
      flex-wrap: wrap;
      gap: 2px 14px;
      min-width: 0;
      padding-left: 4px;
      font: 0.72em/1.7 var(--mono);
  }
  
  .theme-minimal #transcript .mn-xlink {
      color: var(--note);
      text-decoration: none;
  }
  
  .theme-minimal #transcript .mn-xlink::after {
      content: attr(data-label);
  }
  
  .theme-minimal #transcript .mn-xlink:hover {
      text-decoration: underline;
  }
  
  /* P7c compact spawn rows: an async spawn's result card that holds only the
     launch acknowledgement folds into the spawn's branch control — hidden
     (`dag-ack`, written by the engine) until the control's `launched ▸`
     toggle shows it; the control's `Result ↓` links to the notification
     (the merge row) instead of the card's line. The spawn then ends its own
     row, so it takes back the bottom padding a pair's first half gives up. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-ack {
      display: none;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.pair_first:has(> .mn-bctls .mn-back[aria-expanded='false']) {
      padding-bottom: 3px;
  }
  
  .theme-minimal #transcript .mn-bres {
      font: 0.72em/1.7 var(--mono);
      color: var(--note);
      text-decoration: none;
  }
  
  .theme-minimal #transcript .mn-bres::after {
      content: attr(data-label);
  }
  
  .theme-minimal #transcript .mn-bres:hover {
      text-decoration: underline;
  }
  
  .theme-minimal #transcript .mn-bmini.mn-back {
      min-height: 0;
      padding: 2px 0;
      border: 0;
      background: none;
      font: 0.68em/1.7 var(--mono);
  }
  
  /* An async spawn's result card: its answer is on the notification (the
     merge row); this line links there. */
  .theme-minimal #transcript .mn-async-jump {
      margin-top: 2px;
      font: 0.72em/1.7 var(--mono);
      color: var(--muted);
  }
  
  @media (prefers-reduced-motion: reduce) {
      .theme-minimal #transcript .mn-bfold svg {
          transition: none;
      }
  }
  
  /* ------------------------------------------------------------- columns */
  
  /* A lane in a column of its own (DagLanes.dc.html). The stage grid gains a
     track per column (`--dag-cols`, written by the engine: main
     minmax(520px, 2fr), each column minmax(300px, 1fr), a strip 34px; on a
     phone every column the viewport's width, see the phone rules); row 1
     holds the heads, cards start at row 2. The page widens past its 960px
     column to at least the columns' minimum widths (`--dag-min`) and scrolls
     sideways; the page furniture keeps to the viewport (`--dag-view`). */
  .theme-minimal .mn-stage {
      --dag-head-h: 46px;
      /* A column card's row (the engine reads these to draw the column's
         lane): its left padding, gutter and rail; the lane and the dots run
         down the middle of the rail. */
      --dag-col-pad: 8px;
      --dag-col-gut: 60px;
      --dag-col-rail: 16px;
  }
  
  body.theme-minimal.dag-wide {
      max-width: none;
      min-width: calc(var(--dag-min, 0px) + 32px);
  }
  
  body.theme-minimal.dag-wide :is(.mn-top, .mn-toolbar, .filter-toolbar, #timeline-container, .navigation, .page-navigation) {
      position: sticky;
      left: 16px;
      max-width: calc(var(--dag-view, 100vw) - 32px);
      box-sizing: border-box;
  }
  
  .theme-minimal .mn-stage.dag-on.dag-cols #transcript {
      grid-template-columns: var(--dag-cols);
      grid-template-rows: var(--dag-head-h);
  }
  
  /* Column chrome (engine-owned, first in #transcript so it paints under the
     cards): a background per column spanning every row, holding a head that
     sticks under the toolbar. The column's lane is not a border but drawn on
     the rail, over the lane's active span only (minimal_dag.js
     `drawColumns`); a hairline keeps the columns apart. */
  .theme-minimal #transcript > .dag-chrome {
      position: relative;
      min-width: 0;
  }
  
  .theme-minimal #transcript > .dag-colbg:not(.dag-mainbg) {
      background: color-mix(in srgb, var(--lc) 5%, transparent);
      box-shadow: inset 1px 0 0 var(--rule);
  }
  
  .theme-minimal #transcript .dag-colhead {
      position: sticky;
      top: calc(var(--mn-bar-h, 44px) + var(--mn-filter-h, 0px));
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 8px;
      box-sizing: border-box;
      height: var(--dag-head-h);
      min-width: 0;
      padding: 0 8px 0 10px;
      overflow: hidden;
      white-space: nowrap;
      border-bottom: 1px solid var(--rule);
      background: linear-gradient(color-mix(in srgb, var(--lc) 5%, transparent), color-mix(in srgb, var(--lc) 5%, transparent)), var(--bg);
  }
  
  /* A column's head: the name and two compact actions (`⇤`, `−`; their
     words come back once the head is 400px wide) on the first line, the
     lane's stats on a line of their own below — steps, tokens, duration,
     `running` first, so they are what a narrow column keeps; the agent type
     and model follow and give way first (P8: the P7c head put the actions
     beside the meta and truncated it in almost every column). Everything is
     in the head's title. */
  .theme-minimal #transcript .dag-colhead:not(.dag-mainhead) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      align-content: center;
      gap: 1px 8px;
      container-type: inline-size;
  }
  
  .theme-minimal #transcript .dag-colhead:not(.dag-mainhead) > .dag-colname {
      grid-column: 1;
      grid-row: 1;
      white-space: nowrap;
  }
  
  .theme-minimal #transcript .dag-colhead:not(.dag-mainhead) > .dag-colacts {
      grid-column: 2;
      grid-row: 1;
  }
  
  .theme-minimal #transcript .dag-colhead:not(.dag-mainhead) > .dag-colmeta {
      grid-column: 1 / -1;
      grid-row: 2;
  }
  
  .theme-minimal #transcript .dag-colhead:not(.dag-mainhead) .mn-bmini {
      min-width: 22px;
      min-height: 20px;
  }
  
  @container (min-width: 400px) {
      .theme-minimal #transcript .dag-colacts > .mn-bmini[data-long]::after {
          content: attr(data-long);
      }
  }
  
  .theme-minimal #transcript .dag-mainhead {
      padding-left: 6px;
      background: var(--bg);
      font: 600 0.7em var(--mono);
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
  }
  
  .theme-minimal #transcript :is(.dag-mainhead, .dag-colname, .dag-colmeta)::after {
      content: attr(data-label);
  }
  
  .theme-minimal #transcript .dag-colname {
      flex: 0 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 0.92em;
      font-weight: 600;
      color: var(--lc);
  }
  
  .theme-minimal #transcript .dag-colmeta {
      flex: 1 1 0;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      font: 0.66em var(--mono);
      color: var(--muted);
  }
  
  .theme-minimal #transcript .dag-colacts {
      display: flex;
      flex: none;
      gap: 4px;
  }
  
  /* A collapsed column: a 34px strip, the name set vertically. */
  .theme-minimal #transcript .dag-strip {
      position: sticky;
      top: calc(var(--mn-bar-h, 44px) + var(--mn-filter-h, 0px));
      z-index: 3;
      display: block;
      width: 100%;
      padding: 8px 0;
      border: 0;
      background: none;
      font: 600 0.72em var(--mono);
      color: var(--lc);
      cursor: pointer;
  }
  
  .theme-minimal #transcript .dag-strip > span {
      display: inline-block;
      max-height: 50vh;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      writing-mode: vertical-rl;
  }
  
  .theme-minimal #transcript .dag-strip > span::after {
      content: attr(data-label);
  }
  
  .theme-minimal #transcript .dag-strip:hover > span {
      text-decoration: underline;
  }
  
  /* Cards in a column: the compact row (mockup .w-col) — gutter (time, role)
     left-aligned, then the column's rail: its lane (drawn by the engine) and
     the cards' dots, as on the main line. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col {
      grid-template-columns: var(--dag-col-gut) var(--dag-col-rail) minmax(0, 1fr);
      min-width: 0;
      padding-right: 10px;
      padding-left: var(--dag-col-pad);
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col::before {
      justify-self: center;
      margin-left: 0;
      transform: none;
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--lc) 5%, var(--bg));
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col > .header > .header-info {
      align-items: flex-start;
      text-align: left;
  }
  
  /* …so the role icon leads its label, as on a phone. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col .mn-role {
      padding-right: 0;
      padding-left: calc(var(--ic) + var(--ic-gap));
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col .mn-role > .mn-ic {
      right: auto;
      left: 0;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col:is(.system-error, .tool_result.error) .mn-role {
      padding-right: 5px;
      padding-left: calc(5px + var(--ic) + var(--ic-gap));
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-col:is(.system-error, .tool_result.error) .mn-role > .mn-ic {
      left: 5px;
  }
  
  /* A row shared with a taller card in another column would leave a gap
     between a tool call and its output: the call half sits at the bottom of
     its row instead, on top of its output (the gap goes above the step). */
  .theme-minimal .mn-stage.dag-on.dag-cols #transcript .message:is(.pair_first, .pair_middle):not(.dag-split) {
      align-self: end;
  }
  
  /* A lane interleaved inside a column: its tag in the gutter. */
  .theme-minimal .mn-stage.dag-on #transcript .message.dag-colin > .header > .header-info::after {
      content: var(--dag-tag, none);
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--lc);
      font-weight: 600;
  }
  
  .theme-minimal .mn-stage.dag-on #transcript .message.branch-header.dag-col {
      padding-left: calc(var(--dag-col-pad) + var(--dag-col-gut) + var(--dag-col-rail) + 4px);
      border-top-color: var(--lc);
  }
  
  /* Toolbar: the Branches control shows once the page has a branch. */
  .theme-minimal .mn-seg[hidden] {
      display: none;
  }
  
  /* --------------------------------------------------------------- phone */
  
  /* Under 640px the rail is the card's first column (layout.css): main line at
     8px, slots 12px apart, a smaller indent (DagThreads' phone rule). */
  @media (max-width: 640px) {
      .theme-minimal .mn-stage {
          --dag-x0: 8px;
          --dag-step: 12px;
          --dag-ind0: 6px;
          --dag-ind-step: 6px;
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message {
          grid-template-columns: calc(16px + var(--dag-step) * var(--dag-slots, 0)) minmax(0, 1fr);
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-in {
          --dag-c3: calc(16px + var(--dag-step) * var(--dag-slots, 0));
          grid-template-columns: calc(var(--dag-c3) + var(--dag-indent)) minmax(0, 1fr);
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .dag-block .message {
          grid-template-columns: 16px minmax(0, 1fr);
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.branch-header {
          padding-left: calc(16px + var(--dag-step) * var(--dag-slots, 0) + 4px);
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.branch-header.dag-in {
          padding-left: calc(var(--dag-c3) + var(--dag-indent) + 4px);
      }
  
      .theme-minimal #transcript .mn-bctls,
      .theme-minimal #transcript .mn-xlinks {
          grid-column: 2;
          grid-row: 5;
      }
  
      body.theme-minimal.dag-wide {
          min-width: calc(var(--dag-min, 0px) + 20px);
      }
  
      body.theme-minimal.dag-wide :is(.mn-top, .mn-toolbar, .filter-toolbar, #timeline-container, .navigation, .page-navigation) {
          left: 10px;
          max-width: calc(var(--dag-view, 100vw) - 20px);
      }
  
      .theme-minimal .mn-stage {
          --dag-col-gut: 0px;
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-col {
          grid-template-columns: var(--dag-col-rail) minmax(0, 1fr);
      }
  
      .theme-minimal .mn-stage.dag-on #transcript .message.dag-col > .header > .header-info {
          padding-left: 0;
      }
  
      /* Columns on a phone (P7c): every column — main included — is the
         viewport's width (`dag-panes`, tracks written by the engine), and the
         page snaps sideways from one column to the next; vertical scrolling
         is untouched. A strip is passed over. */
      html:has(> body.theme-minimal.dag-wide .mn-stage.dag-panes) {
          scroll-snap-type: x mandatory;
      }
  
      .theme-minimal .mn-stage.dag-panes #transcript > .dag-chrome:not(.dag-stripbg) {
          scroll-snap-align: start;
          scroll-margin-left: 10px;
      }
  }
      </style>
      <script>
          // Minimal theme: apply the stored colour scheme before first paint.
          // `claude-code-log:theme` holds 'auto' | 'light' | 'dark'; only an
          // explicit choice sets <html data-theme>, so 'auto' (and a missing,
          // blocked or unreadable store) follows prefers-color-scheme.
          (function () {
              try {
                  var mode = window.localStorage.getItem('claude-code-log:theme');
                  if (mode === 'light' || mode === 'dark') {
                      document.documentElement.setAttribute('data-theme', mode);
                  }
              } catch (err) { /* storage unavailable: follow the system */ }
          })();
          // Lay the transcript out once: hide the stage while the page parses
          // (dag.css, `mn-parsing`), so the first layout it gets is the DAG
          // engine's grid at DOMContentLoaded, not a nested page laid out
          // frame by frame during the parse and then thrown away. This is the
          // page's first DOMContentLoaded listener, so every other one —
          // folds, filter, deep links, search, the engine — sees the stage
          // rendered, as before; they run in one task, so nothing paints in
          // between.
          (function () {
              var root = document.documentElement;
              root.classList.add('mn-parsing');
              document.addEventListener('DOMContentLoaded', function () {
                  root.classList.remove('mn-parsing');
              });
          })();
      </script>
  </head>
  
  <body class='theme-minimal'><svg class='mn-sprite' xmlns='http://www.w3.org/2000/svg' width='0' height='0' aria-hidden='true' focusable='false'><symbol id="mi-user" viewBox="0 0 16 16"><circle cx="8" cy="5" r="2.75"/><path d="M2.75 14c0-2.9 2.35-4.75 5.25-4.75s5.25 1.85 5.25 4.75"/></symbol><symbol id="mi-steer" viewBox="0 0 16 16"><path d="M3 14V9.5A4.5 4.5 0 0 1 7.5 5H13"/><path d="M10.25 2.25 13 5l-2.75 2.75"/></symbol><symbol id="mi-command" viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" rx="2.5"/><path d="M9.75 4.75 6.25 11.25"/></symbol><symbol id="mi-output" viewBox="0 0 16 16"><path d="M2.5 3.5h11M2.5 6.5h11M2.5 9.5h7.5M2.5 12.5h4.5"/></symbol><symbol id="mi-bash-in" viewBox="0 0 16 16"><path d="M2.5 3.75 6.75 8 2.5 12.25M8.75 12.25h4.75"/></symbol><symbol id="mi-compacted" viewBox="0 0 16 16"><path d="M8 1.5v4.5M5.5 3.5 8 6l2.5-2.5M8 14.5V10M5.5 12.5 8 10l2.5 2.5M2 8h12"/></symbol><symbol id="mi-memory" viewBox="0 0 16 16"><path d="M4 2.25h8v11.5l-4-3-4 3z"/></symbol><symbol id="mi-memory-write" viewBox="0 0 16 16"><path d="M4 2.25h8v11.5l-4-3-4 3z"/><path d="M8 4.75v3.5M6.25 6.5h3.5"/></symbol><symbol id="mi-teammate" viewBox="0 0 16 16"><circle cx="6" cy="5.25" r="2.25"/><path d="M1.75 13.75c0-2.5 1.9-4.25 4.25-4.25s4.25 1.75 4.25 4.25"/><path d="M10.5 3.15a2.25 2.25 0 0 1 0 4.2M12.25 9.9c1.3.55 2 1.85 2 3.85"/></symbol><symbol id="mi-async" viewBox="0 0 16 16"><path d="M4 11.25V7a4 4 0 0 1 8 0v4.25l1.25 1.5H2.75z"/><path d="M6.5 14.75h3"/></symbol><symbol id="mi-assistant" viewBox="0 0 16 16"><path d="M8 1.75c.45 3.3 2.95 5.8 6.25 6.25-3.3.45-5.8 2.95-6.25 6.25-.45-3.3-2.95-5.8-6.25-6.25C5.05 7.55 7.55 5.05 8 1.75z"/></symbol><symbol id="mi-agent" viewBox="0 0 16 16"><rect x="2.5" y="5" width="11" height="8.75" rx="2.25"/><path d="M8 5V2.5M6 8.5V10M10 8.5V10"/></symbol><symbol id="mi-thinking" viewBox="0 0 16 16"><path d="M5.5 10.5a3 3 0 0 1-.75-5.9 4 4 0 0 1 7.15-.85 3.4 3.4 0 0 1 .35 6.75z"/><circle cx="4.25" cy="12.75" r="1"/><path d="M1.9 14.75v.01"/></symbol><symbol id="mi-info" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.25"/><path d="M8 7.25v4M8 4.75v.01"/></symbol><symbol id="mi-warning" viewBox="0 0 16 16"><path d="M8 2.25 14.5 13.5h-13z"/><path d="M8 6.75v3M8 11.5v.01"/></symbol><symbol id="mi-error" viewBox="0 0 16 16"><path d="M5.4 1.75h5.2l3.65 3.65v5.2l-3.65 3.65H5.4L1.75 10.6V5.4z"/><path d="M8 4.75v3.75M8 11.25v.01"/></symbol><symbol id="mi-hook" viewBox="0 0 16 16"><circle cx="10.5" cy="3.25" r="1.5"/><path d="M10.5 4.75V10a3.5 3.5 0 0 1-7 0V8l2.25 2.25"/></symbol><symbol id="mi-recap" viewBox="0 0 16 16"><path d="M2.75 8a5.25 5.25 0 1 0 1.54-3.71"/><path d="M4.25 1.75v2.5h2.5M8 5.25V8l2 1.25"/></symbol><symbol id="mi-image" viewBox="0 0 16 16"><rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.75"/><circle cx="10.25" cy="6.25" r="1.25"/><path d="M2.25 12.25 6 8.5l3.25 3.25 1.5-1.5 3 3"/></symbol><symbol id="mi-branch" viewBox="0 0 16 16"><circle cx="4.5" cy="3.5" r="1.75"/><circle cx="4.5" cy="12.5" r="1.75"/><circle cx="11.5" cy="3.5" r="1.75"/><path d="M4.5 5.25v5.5M11.5 5.25c0 3.75-7 2.5-7 5.5"/></symbol><symbol id="mi-result" viewBox="0 0 16 16"><path d="M13 2.5v5A2.5 2.5 0 0 1 10.5 10H3"/><path d="M6 7 3 10l3 3"/></symbol><symbol id="mi-tool-error" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.25"/><path d="M5.75 5.75l4.5 4.5M10.25 5.75l-4.5 4.5"/></symbol><symbol id="mi-tool" viewBox="0 0 16 16"><path d="M10.1 2a3.6 3.6 0 0 0-3.55 4.75L2.3 11a1.6 1.6 0 0 0 2.3 2.25l4.2-4.2a3.6 3.6 0 0 0 4.75-3.55l-2 2-2.2-.35-.35-2.2z"/></symbol><symbol id="mi-read" viewBox="0 0 16 16"><path d="M1.5 8S4 3.25 8 3.25 14.5 8 14.5 8 12 12.75 8 12.75 1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/></symbol><symbol id="mi-write" viewBox="0 0 16 16"><path d="M9.5 1.75H4.25a1 1 0 0 0-1 1v10.5a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1V5z"/><path d="M9.5 1.75V5h3.25M8 7.5v4.5M5.75 9.75h4.5"/></symbol><symbol id="mi-edit" viewBox="0 0 16 16"><path d="M10.5 2.5a1.75 1.75 0 0 1 2.5 0l.5.5a1.75 1.75 0 0 1 0 2.5L5.5 13.5 2.25 14l.5-3.25z"/><path d="M9.25 3.75 12.25 6.75"/></symbol><symbol id="mi-multiedit" viewBox="0 0 16 16"><path d="M1.75 3h5M1.75 6h3"/><path d="M11.25 4a1.6 1.6 0 0 1 2.25 0l.5.5a1.6 1.6 0 0 1 0 2.25L7.25 13.5 4.25 14l.5-3z"/><path d="M1.75 13.75h1"/></symbol><symbol id="mi-delete" viewBox="0 0 16 16"><path d="M2.25 4.25h11.5M6 4.25V2.25h4v2M3.75 4.25l.75 9.5h7l.75-9.5M6.75 7v4M9.25 7v4"/></symbol><symbol id="mi-bash" viewBox="0 0 16 16"><rect x="1.75" y="2.5" width="12.5" height="11" rx="2"/><path d="M4.5 6.25 6.75 8.5 4.5 10.75M8.5 10.75h3"/></symbol><symbol id="mi-glob" viewBox="0 0 16 16"><path d="M8 2v12M2.8 5l10.4 6M2.8 11l10.4-6"/></symbol><symbol id="mi-grep" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.75"/><path d="M10.5 10.5 14.25 14.25"/></symbol><symbol id="mi-websearch" viewBox="0 0 16 16"><circle cx="6.75" cy="6.75" r="5"/><path d="M1.75 6.75h10M6.75 1.75c-1.75 1.6-1.75 8.4 0 10M6.75 1.75c1.75 1.6 1.75 8.4 0 10M10.5 10.5l3.75 3.75"/></symbol><symbol id="mi-webfetch" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.25"/><path d="M1.75 8h12.5M8 1.75c-2.2 2-2.2 10.5 0 12.5M8 1.75c2.2 2 2.2 10.5 0 12.5"/></symbol><symbol id="mi-taskoutput" viewBox="0 0 16 16"><path d="M1.75 9.25h3.5l1 2h3.5l1-2h3.5"/><path d="M3.75 3h8.5l2 6.25V13a1 1 0 0 1-1 1H2.75a1 1 0 0 1-1-1V9.25z"/></symbol><symbol id="mi-taskstop" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.25"/><rect x="5.75" y="5.75" width="4.5" height="4.5" rx=".5"/></symbol><symbol id="mi-todo" viewBox="0 0 16 16"><path d="M1.75 4.5 3.25 6 5.75 3M1.75 10.5 3.25 12l2.5-3M8.25 4.75h6M8.25 10.75h6"/></symbol><symbol id="mi-ask" viewBox="0 0 16 16"><path d="M2.75 2.5h10.5a1.25 1.25 0 0 1 1.25 1.25v6.5a1.25 1.25 0 0 1-1.25 1.25H7.5L4.5 14v-2.5H2.75a1.25 1.25 0 0 1-1.25-1.25v-6.5A1.25 1.25 0 0 1 2.75 2.5z"/><path d="M6.5 5.4a1.5 1.5 0 1 1 2.1 1.4c-.4.2-.6.55-.6 1v.2M8 9.6v.01"/></symbol><symbol id="mi-plan" viewBox="0 0 16 16"><path d="M5.5 2.75H4.25A1.25 1.25 0 0 0 3 4v9.25a1.25 1.25 0 0 0 1.25 1.25h7.5A1.25 1.25 0 0 0 13 13.25V4a1.25 1.25 0 0 0-1.25-1.25H10.5"/><rect x="5.5" y="1.5" width="5" height="2.5" rx=".75"/><path d="M5.5 9.25 7.25 11l3.25-3.5"/></symbol><symbol id="mi-skill" viewBox="0 0 16 16"><path d="M9.25 1.5 3.5 9h4.25l-1 5.5L12.5 7H8.25z"/></symbol><symbol id="mi-artifact" viewBox="0 0 16 16"><rect x="1.75" y="2.5" width="12.5" height="11" rx="2"/><path d="M1.75 5.75h12.5M6.25 11.25 9.75 7.75M6.75 7.75h3v3"/></symbol><symbol id="mi-monitor" viewBox="0 0 16 16"><path d="M1.5 8.5h2.75l1.75-4.25 3 8.5 1.75-4.25h3.75"/></symbol><symbol id="mi-wakeup" viewBox="0 0 16 16"><circle cx="8" cy="8.75" r="5.25"/><path d="M8 6.25v2.5l1.75 1.25M1.75 4.25 4 2.25M14.25 4.25 12 2.25"/></symbol><symbol id="mi-cron" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="11" rx="1.75"/><path d="M2 6.75h12M5.25 1.75v2.5M10.75 1.75v2.5M5.5 10.25h1M9.5 10.25h1"/></symbol><symbol id="mi-taskcreate" viewBox="0 0 16 16"><rect x="2.25" y="2.25" width="11.5" height="11.5" rx="2.5"/><path d="M8 5.25v5.5M5.25 8h5.5"/></symbol><symbol id="mi-taskupdate" viewBox="0 0 16 16"><rect x="2.25" y="2.25" width="11.5" height="11.5" rx="2.5"/><path d="M5.25 8.25 7.25 10.25 10.75 6"/></symbol><symbol id="mi-tasklist" viewBox="0 0 16 16"><path d="M6 4h8M6 8h8M6 12h8M2 4h1M2 8h1M2 12h1"/></symbol><symbol id="mi-send" viewBox="0 0 16 16"><path d="M14.25 1.75 7 9M14.25 1.75 9.75 14.25 7 9 1.75 6.25z"/></symbol><symbol id="mi-workflow" viewBox="0 0 16 16"><rect x="1.75" y="1.75" width="5.5" height="4.5" rx="1"/><rect x="8.75" y="9.75" width="5.5" height="4.5" rx="1"/><path d="M4.5 6.25v3.5a2 2 0 0 0 2 2h2.25"/></symbol><symbol id="mi-phase" viewBox="0 0 16 16"><path d="M3.5 14.5V1.75"/><path d="M3.5 2.5h9l-2.25 3.25L12.5 9h-9"/></symbol><symbol id="mi-code" viewBox="0 0 16 16"><path d="M5 4.25 1.75 8 5 11.75M11 4.25 14.25 8 11 11.75M9.25 2.75l-2.5 10.5"/></symbol><symbol id="mi-wait" viewBox="0 0 16 16"><path d="M4 1.75h8M4 14.25h8M5 1.75v2.5C5 6 8 6.5 8 8s-3 2-3 3.75v2.5M11 1.75v2.5C11 6 8 6.5 8 8s3 2 3 3.75v2.5"/></symbol></svg>
      <script>
          // ---- rehydrate contract -------------------------------------------
          // A live update (see live_update.js) replaces #transcript wholesale.
          // Anything that decorated the old markup after load has to run again
          // over the new markup: timestamp localisation rewrites innerHTML,
          // the timeline parses message types out of CSS classes, the filter
          // toolbar hides message types, in-page search highlights matches.
          //
          // Delegated listeners (bound on `document`) and everything bound to
          // the toolbar or the floating buttons survive a swap untouched and
          // must NOT be registered here.
          //
          // Defined before any component script so registration never depends
          // on include order.
          (function () {
              const hooks = [];
              window.claudeLogOnRehydrate = function (fn) { hooks.push(fn); };
              window.claudeLogRehydrate = function (root) {
                  hooks.forEach(function (fn) {
                      // One broken hook must not strand the rest — a page that
                      // updated but lost its timeline is better than one that
                      // silently stopped updating.
                      try { fn(root); } catch (err) { console.error('rehydrate hook failed', err); }
                  });
              };
          })();
      </script>
  
      <header class='mn-top'>
      <div class='mn-title-row'><h1 id="title">Test Transcript</h1><span class='mn-pill' title='Main agent model'>claude-3-sonnet-20240229</span><span class='mn-smeta'>test_ses · 2025-07-03 15:50:07 - 2025-07-03 16:10:07 · 11 msgs · 218 in · 445 out</span></div>
      </header>
      <nav class='mn-toolbar' aria-label='Transcript tools'>
          <div class='mn-seg mn-depth' role='group' aria-label='Fold depth'>
              <button type='button' data-mn-depth='prompts' aria-pressed='false' title='Prompts only: fold every turn to its prompt'>Prompts</button>
              <button type='button' class='on' data-mn-depth='steps' aria-pressed='true' title='Steps: every turn open, long blocks as previews, sub-agents folded'>Steps</button>
              <button type='button' data-mn-depth='all' aria-pressed='false' title='All: everything open, every block in full'>All</button>
          </div>
          <div class='mn-seg mn-branches' role='group' aria-label='Branches' hidden>
              <button type='button' class='on' data-mn-branches='main' aria-pressed='true' title='Main only: every branch folded to its control on the spawning row'>Main only</button>
              <button type='button' data-mn-branches='interleaved' aria-pressed='false' title='Interleaved: the first 3 branches of each turn merged into the main line by time'>Interleaved</button>
              <button type='button' data-mn-branches='columns' aria-pressed='false' title='Columns: every branch in a column of its own, time-aligned with the main line (the page scrolls sideways)'>Columns</button>
          </div>
          <span class='mn-sp'></span>
          <button class="filter-messages floating-btn mn-ibtn mn-i-search" id="filterMessages" title="Search & Filter (/)" aria-label="Search and filter">🔍</button>
          <button class="timeline-toggle floating-btn mn-ibtn mn-i-timeline" id="toggleTimeline" title="Show timeline" aria-label="Timeline">📆</button>
          <button class="follow-updates floating-btn mn-ibtn mn-i-follow" id="followUpdates" data-unseen="0"
              title="Follow new messages as they arrive" aria-label="Follow new messages"
              aria-pressed="false">⏬</button>
          
          <button class="resume-session floating-btn mn-ibtn mn-i-resume" id="resumeSession" data-command="cd /tmp &amp;&amp; claude -r test_session"
              title="Resume session: copy the command that resumes this session in Claude Code"
              aria-label="Resume session">▶️</button>
          
          <div class='mn-seg mn-seg-icons' role='group' aria-label='Colour theme'>
              <button type='button' class='on' data-mn-theme='auto' aria-pressed='true' aria-label='Follow system' title='Follow system'><svg width='14' height='14' viewBox='0 0 16 16' fill='none' stroke='currentColor' stroke-width='1.5' aria-hidden='true'><circle cx='8' cy='8' r='5.5'></circle><path d='M8 2.5a5.5 5.5 0 0 1 0 11z' fill='currentColor'></path></svg></button>
              <button type='button' data-mn-theme='light' aria-pressed='false' aria-label='Light' title='Light'><svg width='14' height='14' viewBox='0 0 16 16' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' aria-hidden='true'><circle cx='8' cy='8' r='3'></circle><path d='M8 1.5V3M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1'></path></svg></button>
              <button type='button' data-mn-theme='dark' aria-pressed='false' aria-label='Dark' title='Dark'><svg width='14' height='14' viewBox='0 0 16 16' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linejoin='round' aria-hidden='true'><path d='M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5z'></path></svg></button>
          </div>
          <details class='mn-more'>
              <summary class='mn-ibtn mn-i-more' title='More tools' aria-label='More tools'></summary>
              <div class='mn-menu' role='group' aria-label='More tools'>
                  <button class="toggle-details floating-btn mn-mi" id="toggleDetails" title="Toggle all details">📋</button>
                  <button class="user-view-global floating-btn mn-mi" id="toggleUserView" title="Show user messages as raw text">md</button>
                  <button class="debug-toggle floating-btn mn-mi" id="toggleDebug" title="Show UUIDs">uuid</button>
              </div>
          </details>
