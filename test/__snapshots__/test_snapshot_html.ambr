      <div class='message-node'>
      
      <div class='message assistant' data-uuid='msg_010' id='msg-d-10' data-lane="main">
          <div class='header'>
              <span class='mn-title mn-generic' title="🤖 Assistant"><span class='mn-tn'>🤖 Assistant</span></span>
              <div class='header-info'><span class='mn-role'><svg class='mn-ic' aria-hidden='true'><use href='#mi-assistant'/></svg>Assistant</span>
