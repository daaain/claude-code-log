      :root:not([data-theme="light"]) .theme-minimal .highlight .ss { color: #a5d6ff }
      :root:not([data-theme="light"]) .theme-minimal .highlight .bp { color: #e6edf3 }
      :root:not([data-theme="light"]) .theme-minimal .highlight .fm { color: #d2a8ff; font-weight: bold }
      :root:not([data-theme="light"]) .theme-minimal .highlight .vc { color: #79c0ff }
      :root:not([data-theme="light"]) .theme-minimal .highlight .vg { color: #79c0ff }
      :root:not([data-theme="light"]) .theme-minimal .highlight .vi { color: #79c0ff }
      :root:not([data-theme="light"]) .theme-minimal .highlight .vm { color: #79c0ff }
      :root:not([data-theme="light"]) .theme-minimal .highlight .il { color: #a5d6ff }
  }
  
  :root[data-theme="dark"] .theme-minimal .highlight .hll { background-color: #6e7681 }
  :root[data-theme="dark"] .theme-minimal .highlight .c { color: #8b949e; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .err { border: none; color: #f85149 }
  :root[data-theme="dark"] .theme-minimal .highlight .esc { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .g { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .k { font-weight: normal; color: #ff7b72 }
  :root[data-theme="dark"] .theme-minimal .highlight .l { color: #a5d6ff }
  :root[data-theme="dark"] .theme-minimal .highlight .n { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .o { color: #ff7b72; font-weight: bold }
  :root[data-theme="dark"] .theme-minimal .highlight .x { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .p { color: #e6edf3 }
  :root[data-theme="dark"] .theme-minimal .highlight .ch { color: #8b949e; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .cm { color: #8b949e; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .cp { color: #8b949e; font-weight: bold; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .cpf { color: #8b949e; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .c1 { color: #8b949e; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .cs { color: #8b949e; font-weight: bold; font-style: italic }
  :root[data-theme="dark"] .theme-minimal .highlight .gd { color: #ffa198; background-color: #490202 }
