      <div class='message user' data-uuid='sr_003' id='msg-d-3'>
          <div class='header'>
              <span>🤷 User</span>
              <div class='header-info'>
                  <div class='timestamp-row'>
                      <span class='timestamp' data-timestamp='2025-06-14T12:01:00Z'>2025-06-14 12:01:00</span>
