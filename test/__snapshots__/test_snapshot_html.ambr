                  const next = wanted ? wanted.split(' ') : [];
                  current.forEach(function (cls) { if (next.indexOf(cls) < 0) el.classList.remove(cls); });
                  next.forEach(function (cls) { if (cls && current.indexOf(cls) < 0) el.classList.add(cls); });
