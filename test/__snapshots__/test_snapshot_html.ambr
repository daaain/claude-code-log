              <tr class='tool-param-row-fold'>
                  <td class='tool-param-key'><button type='button' class='tool-param-key-toggle' aria-expanded='false'><span class='tool-param-fold-glyph'></span>4</button></td>
                  <td class='tool-param-value'>
                          <details class='tool-param-collapsible'>
                              <summary><span class='tool-param-preview'>{
    &quot;id&quot;: &quot;5&quot;,
    &quot;content&quot;: &quot;Perform code review&quot;,
    &quot;status&quot;: &quot;pending&quot;,
    &quot;priority&quot;: &quot;medium&quot;
  }</span></summary>
                              <table class='tool-params-table tool-params-nested'>
              <tr>
                  <td class='tool-param-key'><span class='tool-param-fold-glyph'></span>id</td>
                  <td class='tool-param-value'>5</td>
              </tr>
          
              <tr>
                  <td class='tool-param-key'><span class='tool-param-fold-glyph'></span>content</td>
                  <td class='tool-param-value'>Perform code review</td>
